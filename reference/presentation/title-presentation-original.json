      "color": 25,
      "text": [
        {
          "column": 2,
          "row": 21,
          "text": "It was August 1938, a peaceful time,"
        },
        {
          "column": 1,
          "row": 22,
          "text": "and the nation was engrossed in apple"
        },
        {
          "column": 3,
          "row": 23,
          "text": "pie and twelve cylinder Lincolns."
        }
      ],
      "frame": "title-story-0.bin",
      "frame_sha256": "cebfc90206d0a1e4e387b95f9094d46197e26dad6698216fca6c649ea34a80a2"
    },
    {
      "id": 1,
      "x": 96,
      "y": 20,
      "vga": "vga/cap1cj.vga",
      "shipped_jpeg": "CAP1CJ.JPG",
      "color": 11,
      "text": [
        {
          "column": 0,
          "row": 0,
          "text": "But suddenly....."
        },
        {
          "column": 12,
          "row": 13,
          "text": "Tragedy strikes!"
        },
        {
          "column": 1,
          "row": 16,
          "text": "Aliens attacked.  The slow, systematic"
        },
        {
          "column": 5,
          "row": 17,
          "text": "destruction of our Earth began."
        },
        {
          "column": 3,
          "row": 19,
          "text": "Now, 11 years later, humankind has"
        },
        {
          "column": 8,
          "row": 20,
          "text": "begun to turn the tide."
        },
        {
          "column": 0,
          "row": 24,
          "text": "It's time for you to join the battle..."
        }
      ],
      "frame": "title-story-1.bin",
      "frame_sha256": "62f3313cf5273c2473e4c9ab973e2503898d1a392ade73fb3300500c5241ad24"
    }
