      "behavior": "HC6 palette, vertically mirrored TNAMBC background, HC6NEW aircraft, FLASH and sprite effects; original page copies and per-frame state."
    },
    {
      "id": "logo_and_credit_animation",
      "image_start": "4fd8",
      "image_end": "5582",
      "behavior": "GRADSKY palette, vertically mirrored TCLOUD5S strip, top/bottom logos, scrolling credits, optional DESTINY3.ROL. Repeat aircraft phase unless exit byte==ESC."
    },
    {
      "id": "exit",
      "image_start": "55a2",
      "image_end": "55e2",
      "behavior": "Stop source sound/channel state and restore graphics before returning to MOAG."
    }
