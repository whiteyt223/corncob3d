  "animation_controls": {
    "escape": "exit",
    "minus": "decrement DS27be; signed clamp minimum1",
    "plus": "increment DS27be; signed clamp maximum150",
    "q_or_Q": "XOR DS1278 withffff",
    "lowercase_l": "XOR localBP-2c with00ff; DSe9c=224; DSe9e=255; clear last key",
    "other": "exit; aircraft phase instead performs the lowercase-l action when DS00d0!=0",
    "default_speed_word": 4,
    "default_first_aircraft_flag": 1
  },
